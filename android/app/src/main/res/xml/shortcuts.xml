<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen launcher shortcuts (long-press the app icon). These are the app's most
  frequent "jump straight to it" destinations, mirroring the in-app quick-actions sheet
  plus the two the brief already called out (Journal, Settings).

  Ordering matters: launchers surface static shortcuts in declaration order and most only
  show ~4 at once, so the strongest daily actions lead. Ranked:
    1. Live HR      — the signature real-time heart-rate view
    2. Sleep        — the morning "how did I sleep" glance
    3. Start workout — begin a session in one tap
    4. Journal      — log how you feel (maps to the Insights/journal screen)
    5. Settings     — least "quick action"-y, so it trails

  Each shortcut launches an implicit VIEW intent with a "noop://open/<key>" data URI
  instead of an explicit component. That keeps the file flavor-independent: the four
  build flavors (full / demo / preview, plus the .debug suffix) all have DIFFERENT
  applicationIds, so a hardcoded targetPackage would break three of them. MainActivity
  declares the matching <data android:scheme="noop"> intent-filter and maps the path
  segment to a nav route (see ShortcutRoutes in MainActivity.kt).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="live"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_live"
        android:shortcutShortLabel="@string/shortcut_live_short"
        android:shortcutLongLabel="@string/shortcut_live_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="noop://open/live" />
    </shortcut>

    <shortcut
        android:shortcutId="sleep"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sleep"
        android:shortcutShortLabel="@string/shortcut_sleep_short"
        android:shortcutLongLabel="@string/shortcut_sleep_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="noop://open/sleep" />
    </shortcut>

    <shortcut
        android:shortcutId="workout"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_workout"
        android:shortcutShortLabel="@string/shortcut_workout_short"
        android:shortcutLongLabel="@string/shortcut_workout_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="noop://open/workouts" />
    </shortcut>

    <shortcut
        android:shortcutId="journal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_journal"
        android:shortcutShortLabel="@string/shortcut_journal_short"
        android:shortcutLongLabel="@string/shortcut_journal_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="noop://open/journal" />
    </shortcut>

    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings_short"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="noop://open/settings" />
    </shortcut>

</shortcuts>
